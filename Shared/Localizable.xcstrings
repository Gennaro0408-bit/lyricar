    "On: lyrics stay in sync on CarPlay even with the app closed. Turns off by itself after 15 minutes without music once CarPlay is disconnected.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva: i testi restano sincronizzati su CarPlay anche con l'app chiusa. Si spegne da sola dopo 15 minuti senza musica, una volta scollegato CarPlay."
          }
        }
      }
    },

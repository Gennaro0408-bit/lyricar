  "strings": {
    "%@ · %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "Account not authorized: add it under User Management on the Spotify dashboard": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Account non autorizzato: aggiungilo in User Management sulla dashboard Spotify"
          }
        }
      }
    },
    "Applies only to the song that's playing. Lyrics late → increase; early → decrease.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale solo per la canzone in riproduzione. Testo in ritardo → aumenta; in anticipo → diminuisci."
          }
        }
      }
    },
    "Artist": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Artista"
          }
        }
      }
    },
    "CarPlay → Connects → “Start lyrics in the car”": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay → Si connette → “Avvia testi in auto”"
          }
        }
      }
    },
    "CarPlay → Disconnects → “Stop lyrics in the car”": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",

    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la guida Lyricar usa la posizione solo per restare attiva in background, così i testi su CarPlay restano sincronizzati anche dopo una telefonata. La posizione non viene salvata né inviata."
